# Copie para .env (fica fora do git).
# Pasta onde os backups ficam (padrão: ./data, ao lado deste arquivo).
BACKUP_DIR=./data
TZ=America/Sao_Paulo
PUID=1000
PGID=1000
# Opcional: webhook do Discord (embed) ou outra URL que receba POST de texto (ntfy). Vazio = sem notificação.
NOTIFY_URL=
WEB_PORT=8765
# Opcional: senha da interface web. Vazio = sem login (qualquer aparelho da rede acessa).
# Definida, tudo exige login: páginas, API e downloads.
WEB_PASSWORD=
